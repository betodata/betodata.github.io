---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { profile } from '../lib/data.js';

const { title, description, current, theme = 'light' } = Astro.props;
const full = title ? `${title} · ${profile.name}` : profile.name;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description ?? profile.tagline} />
  <meta name="author" content={profile.name} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <meta property="og:title" content={full} />
  <meta property="og:description" content={description ?? profile.tagline} />
  <meta property="og:type" content="website" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,200;0,300;0,400;0,500;1,300;1,400&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&family=IBM+Plex+Mono:wght@400;500&display=swap" />
</head>
<body class={theme}>
  <a class="skip" href="#main">Skip to content</a>
  <Nav current={current} />
  <main id="main"><slot /></main>
  <footer class="foot">
    <div class="l">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <a href="/cv.pdf" target="_blank" rel="noopener">Curriculum Vitae (PDF)</a>
      <a href={profile.profiles.google_scholar} target="_blank" rel="noopener">Google Scholar</a>
    </div>
    <div>{profile.institution}</div>
  </footer>
</body>
</html>
